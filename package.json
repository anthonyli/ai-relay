{
  "name": "ai-relay-cli",
  "version": "0.1.1",
  "description": "Universal backup, export, import, and restore for AI coding CLI sessions.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonyli/ai-relay.git"
  },
  "bugs": {
    "url": "https://github.com/anthonyli/ai-relay/issues"
  },
  "homepage": "https://github.com/anthonyli/ai-relay#readme",
  "bin": {
    "airelay": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node ./scripts/ensure-user-config-dir.mjs",
    "start": "node dist/index.js"
  },
  "keywords": [
    "ai",
    "cli",
    "backup",
    "claude",
    "codex",
    "sessions"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@clack/prompts": "^0.11.0",
    "archiver": "^7.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.2",
    "ora": "^9.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1",
    "yauzl": "^3.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@types/yauzl": "^2.10.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=20"
  }
}
